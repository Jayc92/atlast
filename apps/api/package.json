{
  "name": "@atlast/api",
  "version": "0.0.0",
  "private": true,
  "description": "Atlast backend API (query API host) — M0 shell per ADR-0004: Fastify, localhost-only, health endpoint only.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@atlast/connectors": "workspace:*",
    "@atlast/graph-model": "workspace:*",
    "@atlast/impact-model": "workspace:*",
    "@atlast/overlay-model": "workspace:*",
    "@atlast/shared": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.10"
  }
}
